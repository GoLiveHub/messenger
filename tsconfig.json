{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/auth.ts",
    "src/config.ts",
    "src/crypto.ts",
    "src/db.ts",
    "src/helpers.ts",
    "src/index.ts",
    "src/sockets.ts",
    "src/push.ts",
    "src/lib/rateLimit.ts",
    "src/lib/sms.ts",
    "src/lib/logger.ts",
    "src/lib/redis.ts",
    "src/lib/storage.ts",
    "src/lib/totp.ts",
    "src/crypto.worker.ts"
  ]
}
