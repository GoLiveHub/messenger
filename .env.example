# Copy to .env and fill in real values.
NODE_ENV=production
PORT=3001

# REQUIRED for multi-instance (Railway/Nomad/kubernetes) deployments:
# the per-IP / per-user rate limiter and Socket.IO presence are stored in
# Redis. WITHOUT this every replica counts independently, so bursting N
# requests across M replicas opens M buckets (~300/M allowed) and the
# RateLimit headers appear to "jump". Point this at the same Redis for all
# replicas. In-memory fallback still works for single-instance deployments.
REDIS_URL=redis://redis:6379

# Only set TRUST_PROXY=1 when a trusted reverse proxy (nginx, Railway edge,
# Traefik) sits directly in front of the app AND rewrites/strips the client's
# X-Forwarded-For. When set, the first XFF entry is treated as the client IP.
# Leave UNSET if clients can reach the app directly or the proxy appends
# untrusted XFF headers (header-rotation would re-open fresh rate-limit
# buckets, the exact vector the pentest exploited).
# TRUST_PROXY=1

# REQUIRED in production
SERVER_SECRET=replace-with-a-long-random-string

# Web Push (VAPID). Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@messenger.local

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://messenger.example.com

# SMS provider: console | twilio | smsru | none
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_RU_API_KEY=
SMS_RU_FROM=

# Data retention (days)
DATA_RETENTION_DAYS=365

# Optional: S3-compatible object storage for auto-backup export + media
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_BUCKET=messenger
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Log level: error | warn | info | debug
LOG_LEVEL=info