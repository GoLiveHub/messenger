# ===================== Application =====================
# Local single-computer mode. Codes are shown in the UI and server console.
NODE_ENV=development
PORT=3001
DB_PATH=data/messenger.db
SERVER_SECRET=replace-with-at-least-32-random-bytes
EXPOSE_DEV_CODE=true
ALLOWED_ORIGINS=http://messenger.local,http://127.0.0.1,http://localhost

# ===================== Database =====================
# Driver: sqlite (default) | postgres
DB_DRIVER=sqlite

# PostgreSQL (only used when DB_DRIVER=postgres)
DATABASE_URL=postgresql://messenger:secret@localhost:5432/messenger

# ===================== Redis =====================
# Set REDIS_URL to enable Redis-backed rate limiting, session caching, and presence tracking.
# Leave unset for in-memory fallback.
# REDIS_URL=redis://localhost:6379
# REDIS_RATE_PREFIX=ratelimit

# ===================== SMS Provider =====================
# SMS_PROVIDER: console | twilio | smsru | none
SMS_PROVIDER=console

# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# SMS.ru
# SMS_RU_API_KEY=
# SMS_RU_FROM=

# ===================== Web Push (VAPID) =====================
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@messenger.local

# ===================== GIF Search (Tenor) =====================
# TENOR_API_KEY=

# ===================== Logging =====================
# LOG_LEVEL: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# ===================== Deployment =====================
# For an Internet deployment, use NODE_ENV=production, HTTPS at the reverse
# proxy, EXPOSE_DEV_CODE=false and configure the SMS webhook below.
# SMS_WEBHOOK_URL=https://sms-gateway.example/send
# SMS_WEBHOOK_TOKEN=replace-me
